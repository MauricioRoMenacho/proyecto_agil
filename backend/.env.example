# === BASE DE DATOS ===
# Cadena de conexión completa de Render PostgreSQL (o Supabase).
# Render la pone aquí automáticamente si enlazas la BD al servicio.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Si usas Render PostgreSQL marca esta opción como 'true'
DB_SSL=true

# === AUTENTICACIÓN JWT ===
JWT_SECRET=cambia_esta_clave_secreta_por_una_muy_larga_y_aleatoria

# === SERVIDOR ===
# Render asigna PORT automáticamente; solo úsalo en local.
PORT=3000
